# Copy this file to .env and adjust if your API runs somewhere other than
# the default below (see server/.env.example for the backend's own config).
VITE_API_URL=http://localhost:5000/api

# Firebase web app config — from Firebase Console -> Project settings ->
# General -> "Your apps" -> click your web app (or "Add app" -> Web if you
# haven't registered one yet). These are safe to expose in the frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# From Firebase Console -> Project settings -> Cloud Messaging -> "Web
# configuration" -> Web Push certificates -> generate/copy the key pair.
VITE_FIREBASE_VAPID_KEY=
